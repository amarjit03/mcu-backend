# Project Settings
PROJECT_NAME="Student Complaint Management System"
ENV=dev
DEBUG=True
PORT=8000

# Database Configuration
# For SQLite local development: sqlite:///./complaint_system.db
# For PostgreSQL Production (e.g., Neon DB):
# DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require
DATABASE_URL=sqlite:///./complaint_system.db

# Redis Caching & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=7ba72f4e0c7a52fbd1e712a768d4a9d70deef5f6a61eb3d1544a0378e9185a3c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
